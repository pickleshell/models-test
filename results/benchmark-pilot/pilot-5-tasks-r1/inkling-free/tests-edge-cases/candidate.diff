 export function parseRange(value) {
   if (typeof value !== 'string') return null;
-  const [left, right] = value.split('..');
+  const trimmed = value.trim();
+  const parts = trimmed.split('..');
+  if (parts.length !== 2) return null;
+  const left = parts[0].trim();
+  const right = parts[1].trim();
+  if (left === '' || right === '') return null;
+  // Reject decimals or non-digit strings (except optional leading minus)
+  const intRegex = /^-?\d+$/;
+  if (!intRegex.test(left) || !intRegex.test(right)) return null;
   const start = Number(left);
   const end = Number(right);
   if (!Number.isInteger(start) || !Number.isInteger(end)) return null;
+  if (start < -100000 || start > 100000 || end < -100000 || end > 100000) return null;
+  if (start > end) return null;
   return { start, end };
 }
