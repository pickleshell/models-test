@@ -6,3 +6,34 @@ test('parses an inclusive range', () => assert.deepEqual(parseRange('2..7'), { s
 test('accepts surrounding whitespace', () => assert.deepEqual(parseRange(' -2..0 '), { start: -2, end: 0 }));
 test('rejects malformed ranges', () => assert.equal(parseRange('2-7'), null));
 test('rejects a reversed range', () => assert.equal(parseRange('7..2'), null));
+
+test('rejects non-string input', () => assert.equal(parseRange(42), null));
+test('rejects null input', () => assert.equal(parseRange(null), null));
+test('rejects undefined input', () => assert.equal(parseRange(undefined), null));
+test('rejects object input', () => assert.equal(parseRange({}), null));
+
+test('rejects empty string', () => assert.equal(parseRange(''), null));
+test('rejects whitespace-only string', () => assert.equal(parseRange('   '), null));
+test('rejects string with only ..', () => assert.equal(parseRange('..'), null));
+
+test('rejects multiple .. separators', () => assert.equal(parseRange('1..2..3'), null));
+
+test('rejects missing right value', () => assert.equal(parseRange('1..'), null));
+test('rejects missing left value', () => assert.equal(parseRange('..1'), null));
+
+test('rejects decimal start', () => assert.equal(parseRange('1.5..2'), null));
+test('rejects decimal end', () => assert.equal(parseRange('1..2.5'), null));
+test('rejects both decimals', () => assert.equal(parseRange('1.5..2.5'), null));
+
+test('rejects start below lower bound', () => assert.equal(parseRange('-100001..0'), null));
+test('rejects end above upper bound', () => assert.equal(parseRange('0..100001'), null));
+test('rejects both out of bounds', () => assert.equal(parseRange('-200000..200000'), null));
+
+test('accepts exact lower bound', () => assert.deepEqual(parseRange('-100000..-100000'), { start: -100000, end: -100000 }));
+test('accepts exact upper bound', () => assert.deepEqual(parseRange('100000..100000'), { start: 100000, end: 100000 }));
+test('accepts full range', () => assert.deepEqual(parseRange('-100000..100000'), { start: -100000, end: 100000 }));
+
+test('rejects Infinity', () => assert.equal(parseRange('Infinity..Infinity'), null));
+test('rejects NaN', () => assert.equal(parseRange('NaN..NaN'), null));
