@@ -6,3 +6,47 @@ test('parses an inclusive range', () => assert.deepEqual(parseRange('2..7'), { s
 test('accepts surrounding whitespace', () => assert.deepEqual(parseRange(' -2..0 '), { start: -2, end: 0 }));
 test('rejects malformed ranges', () => assert.equal(parseRange('2-7'), null));
 test('rejects a reversed range', () => assert.equal(parseRange('7..2'), null));
+
+test('accepts the inclusive bounds', () => assert.deepEqual(parseRange('-100000..100000'), { start: -100000, end: 100000 }));
+test('accepts a single-value range', () => assert.deepEqual(parseRange('5..5'), { start: 5, end: 5 }));
+test('parses negative ranges', () => assert.deepEqual(parseRange('-10..-2'), { start: -10, end: -2 }));
+test('accepts tabs and newlines as surrounding whitespace', () => assert.deepEqual(parseRange('\t3..8\n'), { start: 3, end: 8 }));
+
+test('rejects non-string input', () => {
+  for (const value of [null, undefined, 42, Number.NaN, true, {}, ['2..7']]) {
+    assert.equal(parseRange(value), null);
+  }
+});
+
+test('rejects empty or missing parts', () => {
+  for (const value of ['', '..', '2..', '..7']) {
+    assert.equal(parseRange(value), null);
+  }
+});
+
+test('rejects extra range segments', () => assert.equal(parseRange('2..7..9'), null));
+test('rejects non-numeric text', () => assert.equal(parseRange('two..seven'), null));
+
+test('rejects decimals', () => {
+  assert.equal(parseRange('1.5..3'), null);
+  assert.equal(parseRange('1..3.5'), null);
+});
+
+test('rejects non-base-10 notation', () => {
+  assert.equal(parseRange('0x10..20'), null);
+  assert.equal(parseRange('1e3..2000'), null);
+  assert.equal(parseRange('+2..5'), null);
+});
+
+test('rejects whitespace inside the range', () => assert.equal(parseRange('2 .. 7'), null));
+
+test('rejects out-of-bound endpoints', () => {
+  assert.equal(parseRange('-100001..0'), null);
+  assert.equal(parseRange('0..100001'), null);
+  assert.equal(parseRange('-100001..100001'), null);
+});
+
+test('rejects reversed ranges across signs and bounds', () => {
+  assert.equal(parseRange('-2..-10'), null);
+  assert.equal(parseRange('100000..-100000'), null);
+});
