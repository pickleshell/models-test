+  // Validate inputs - missing or invalid input is disabled
+  if (!config || !context || typeof config !== 'object' || typeof context !== 'object') {
+    return false;
+  }
+
+  const { feature, overrides, userId } = context;
+  
+  // Check for exact boolean override first (wins over everything)
+  if (overrides && typeof overrides === 'object' && feature in overrides) {
+    const override = overrides[feature];
+    if (typeof override === 'boolean') {
+      return override;
+    }
+  }
+
+  // Get the flag value from config
+  const flag = config[feature];
+  
+  // If flag is a boolean, return it directly
+  if (typeof flag === 'boolean') {
+    return flag;
+  }
+  
+  // If flag is an object with enabled and rollout properties
+  if (flag && typeof flag === 'object') {
+    // If enabled is false, always return false
+    if (flag.enabled !== true) {
+      return false;
+    }
+    
+    // Handle rollout percentage
+    if (typeof flag.rollout === 'number') {
+      // Validate rollout is between 0 and 100
+      if (flag.rollout < 0 || flag.rollout > 100 || !Number.isInteger(flag.rollout)) {
+        return false;
+      }
+      
+      // If rollout is 100%, always enabled
+      if (flag.rollout === 100) {
+        return true;
+      }
+      
+      // If rollout is 0%, always disabled
+      if (flag.rollout === 0) {
+        return false;
+      }
+      
+      // Use stable hash of userId for rollout determination
+      if (userId) {
+        // Simple stable hash function using user ID
+        let hash = 0;
+        for (let i = 0; i < userId.length; i++) {
+          const char = userId.charCodeAt(i);
+          hash = ((hash << 5) - hash) + char;
+          hash = hash & hash; // Convert to 32bit integer
+        }
+        
+        // Normalize hash to 0-100 range
+        const hashPercentage = Math.abs(hash) % 100;
+        return hashPercentage < flag.rollout;
+      }
+      
+      // If no userId, treat as rollout not applicable
+      return false;
+    }
+    
+    // If enabled exists and no rollout, return enabled value
+    return flag.enabled === true;
+  }
+  
+  // Missing or invalid input is disabled
+  return false;
 }
