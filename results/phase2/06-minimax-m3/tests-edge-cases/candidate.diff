+
+test('accepts the lower bound', () => assert.deepEqual(parseRange('-100000..-100000'), { start: -100000, end: -100000 }));
+test('accepts the upper bound', () => assert.deepEqual(parseRange('0..100000'), { start: 0, end: 100000 }));
+test('accepts a single-point range', () => assert.deepEqual(parseRange('5..5'), { start: 5, end: 5 }));
+test('rejects a range below the lower bound', () => assert.equal(parseRange('-100001..0'), null));
