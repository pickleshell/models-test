diff --git a/fixtures/phase2/tests-edge-cases/test/range.test.mjs b/fixtures/phase2/tests-edge-cases/test/range.test.mjs
index f2758d0..9799267 100644
--- a/fixtures/phase2/tests-edge-cases/test/range.test.mjs
+++ b/fixtures/phase2/tests-edge-cases/test/range.test.mjs
@@ -6,3 +6,42 @@ test('parses an inclusive range', () => assert.deepEqual(parseRange('2..7'), { s
 test('accepts surrounding whitespace', () => assert.deepEqual(parseRange(' -2..0 '), { start: -2, end: 0 }));
 test('rejects malformed ranges', () => assert.equal(parseRange('2-7'), null));
 test('rejects a reversed range', () => assert.equal(parseRange('7..2'), null));
+
+test('rejects non-string input', () => {
+  assert.equal(parseRange(undefined), null);
+  assert.equal(parseRange(null), null);
+  assert.equal(parseRange(123), null);
+  assert.equal(parseRange(true), null);
+  assert.equal(parseRange({}), null);
+  assert.equal(parseRange([]), null);
+});
+
+test('rejects empty string', () => assert.equal(parseRange(''), null));
+
+test('rejects bare double-dot', () => assert.equal(parseRange('..'), null));
+
+test('rejects missing right operand', () => assert.equal(parseRange('1..'), null));
+
+test('rejects missing left operand', () => assert.equal(parseRange('..1'), null));
+
+test('rejects triple-dot', () => assert.equal(parseRange('1...2'), null));
+
+test('rejects decimal start', () => assert.equal(parseRange('2.5..3'), null));
+
+test('rejects decimal end', () => assert.equal(parseRange('2..3.5'), null));
+
+test('rejects value below lower bound', () => assert.equal(parseRange('-100001..0'), null));
+
+test('rejects value above upper bound', () => assert.equal(parseRange('0..100001'), null));
+
+test('accepts boundary range', () => assert.deepEqual(parseRange('-100000..100000'), { start: -100000, end: 100000 }));
+
+test('accepts equal bounds', () => assert.deepEqual(parseRange('5..5'), { start: 5, end: 5 }));
+
+test('accepts negative-to-positive range', () => assert.deepEqual(parseRange('-3..3'), { start: -3, end: 3 }));
+
+test('accepts all-negative range', () => assert.deepEqual(parseRange('-9..-1'), { start: -9, end: -1 }));
+
+test('rejects space inside left operand', () => assert.equal(parseRange('1 ..2'), null));
+
+test('rejects space inside right operand', () => assert.equal(parseRange('1.. 2'), null));
