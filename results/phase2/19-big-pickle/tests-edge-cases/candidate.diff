@@ -6,3 +6,22 @@ test('parses an inclusive range', () => assert.deepEqual(parseRange('2..7'), { s
 test('accepts surrounding whitespace', () => assert.deepEqual(parseRange(' -2..0 '), { start: -2, end: 0 }));
 test('rejects malformed ranges', () => assert.equal(parseRange('2-7'), null));
 test('rejects a reversed range', () => assert.equal(parseRange('7..2'), null));
+
+test('zero-width range is valid', () => assert.deepEqual(parseRange('5..5'), { start: 5, end: 5 }));
+test('boundary -100000..100000 is valid', () => assert.deepEqual(parseRange('-100000..100000'), { start: -100000, end: 100000 }));
+test('below lower bound is rejected', () => assert.equal(parseRange('-100001..0'), null));
+test('above upper bound is rejected', () => assert.equal(parseRange('0..100001'), null));
+test('decimal left is rejected', () => assert.equal(parseRange('1.5..2'), null));
+test('decimal right is rejected', () => assert.equal(parseRange('1..2.5'), null));
+test('missing left part is rejected', () => assert.equal(parseRange('..5'), null));
+test('missing right part is rejected', () => assert.equal(parseRange('5..'), null));
