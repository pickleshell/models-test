+test('null rejected', () => assert.equal(parseRange(null), null));
+test('undefined rejected', () => assert.equal(parseRange(undefined), null));
+test('empty string rejected', () => assert.equal(parseRange(''), null));
+test('array rejected', () => assert.equal(parseRange([]), null));
+test('object rejected', () => assert.equal(parseRange({}), null));
+test('leading zeros accepted', () => assert.deepEqual(parseRange('01..05'), { start: 1, end: 5 }));
