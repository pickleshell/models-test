 }
diff --git a/fixtures/phase2/tests-edge-cases/test/range.test.mjs b/fixtures/phase2/tests-edge-cases/test/range.test.mjs
index f2758d0..08dbf90 100644
--- a/fixtures/phase2/tests-edge-cases/test/range.test.mjs
+++ b/fixtures/phase2/tests-edge-cases/test/range.test.mjs
@@ -6,3 +6,42 @@ test('parses an inclusive range', () => assert.deepEqual(parseRange('2..7'), { s
 test('accepts surrounding whitespace', () => assert.deepEqual(parseRange(' -2..0 '), { start: -2, end: 0 }));
 test('rejects malformed ranges', () => assert.equal(parseRange('2-7'), null));
 test('rejects a reversed range', () => assert.equal(parseRange('7..2'), null));
+
+test('accepts the exact inclusive bounds', () => assert.deepEqual(parseRange('-100000..100000'), { start: -100000, end: 100000 }));
+test('accepts a single-point range at the boundary', () => assert.deepEqual(parseRange('-100000..-100000'), { start: -100000, end: -100000 }));
+test('accepts a single-point range in the middle', () => assert.deepEqual(parseRange('5..5'), { start: 5, end: 5 }));
+test('accepts zero as a valid integer', () => assert.deepEqual(parseRange('0..0'), { start: 0, end: 0 }));
+
+test('rejects start below the lower bound', () => assert.equal(parseRange('-100001..0'), null));
+test('rejects end above the upper bound', () => assert.equal(parseRange('0..100001'), null));
+
+test('rejects decimals in either operand', () => {
+  assert.equal(parseRange('2.5..7'), null);
+  assert.equal(parseRange('2..7.5'), null);
+  assert.equal(parseRange('2..7.0'), null);
+});
+
+test('rejects non-string input', () => {
+  assert.equal(parseRange(null), null);
+  assert.equal(parseRange(undefined), null);
+  assert.equal(parseRange(5), null);
+  assert.equal(parseRange({}), null);
+  assert.equal(parseRange([]), null);
+  assert.equal(parseRange(true), null);
+});
+
+test('rejects malformed ranges', () => {
+  assert.equal(parseRange(''), null);
+  assert.equal(parseRange('abc'), null);
+  assert.equal(parseRange('2..'), null);
+  assert.equal(parseRange('..7'), null);
+  assert.equal(parseRange('2..7..3'), null);
+  assert.equal(parseRange(' 2 .. 7 '), null);
+  assert.equal(parseRange('+5..7'), null);
+});
+
+test('rejects hex and exponent notation', () => {
+  assert.equal(parseRange('0x10..7'), null);
+  assert.equal(parseRange('1e2..7'), null);
+  assert.equal(parseRange('2..7e1'), null);
+});
