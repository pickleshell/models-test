+test('accepts the inclusive numeric boundaries', () => {
+  assert.deepEqual(parseRange('-100000..100000'), { start: -100000, end: 100000 });
+});
+
+test('rejects values outside the supported bounds', () => {
+  assert.equal(parseRange('-100001..0'), null);
+  assert.equal(parseRange('0..100001'), null);
+});
+
+test('rejects decimals, signs, and extra separators', () => {
