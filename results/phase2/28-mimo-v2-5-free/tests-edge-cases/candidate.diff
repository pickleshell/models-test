+test('rejects single-dot separator', () => assert.equal(parseRange('1.2'), null));
+
+test('rejects decimals in start', () => assert.equal(parseRange('1.5..3'), null));
+test('rejects decimals in end', () => assert.equal(parseRange('1..2.5'), null));
