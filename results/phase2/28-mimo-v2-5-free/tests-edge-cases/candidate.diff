 test('accepts surrounding whitespace', () => assert.deepEqual(parseRange(' -2..0 '), { start: -2, end: 0 }));
 test('rejects malformed ranges', () => assert.equal(parseRange('2-7'), null));
 test('rejects a reversed range', () => assert.equal(parseRange('7..2'), null));
+
+test('rejects non-string input: null', () => assert.equal(parseRange(null), null));
+test('rejects non-string input: undefined', () => assert.equal(parseRange(undefined), null));
+test('rejects non-string input: number', () => assert.equal(parseRange(42), null));
+test('rejects non-string input: object', () => assert.equal(parseRange({}), null));
+test('rejects non-string input: array', () => assert.equal(parseRange([]), null));
+test('rejects non-string input: boolean', () => assert.equal(parseRange(true), null));
+
+test('rejects empty string', () => assert.equal(parseRange(''), null));
+test('rejects whitespace-only string', () => assert.equal(parseRange('   '), null));
