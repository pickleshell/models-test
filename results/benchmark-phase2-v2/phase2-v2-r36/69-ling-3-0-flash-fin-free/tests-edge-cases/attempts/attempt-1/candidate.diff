 import test from 'node:test';
 import assert from 'node:assert/strict';
 import { parseRange } from '../src/range.js';
+
 test('parses an inclusive range', () => assert.deepEqual(parseRange('2..7'), { start: 2, end: 7 }));
 test('accepts surrounding whitespace', () => assert.deepEqual(parseRange(' -2..0 '), { start: -2, end: 0 }));
 test('rejects one malformed range', () => assert.equal(parseRange('2-7'), null));
 test('rejects a reversed range', () => assert.equal(parseRange('7..2'), null));
+
+test('rejects non-string input', () => {
+  assert.equal(parseRange(42), null);
+  assert.equal(parseRange(null), null);
+  assert.equal(parseRange(undefined), null);
+  assert.equal(parseRange({}), null);
+  assert.equal(parseRange([]), null);
+});
+
+test('rejects extra separators', () => assert.equal(parseRange('1..2..3'), null));
+
+test('rejects decimal values', () => assert.equal(parseRange('1.5..3'), null));
+
+test('rejects exponent notation', () => assert.equal(parseRange('1e3..5'), null));
+
+test('rejects hexadecimal syntax', () => assert.equal(parseRange('0x10..5'), null));
+
+test('accepts positive sign prefix', () => assert.deepEqual(parseRange('+5..+10'), { start: 5, end: 10 }));
+
+test('accepts negative start and end', () => assert.deepEqual(parseRange('-5..-1'), { start: -5, end: -1 }));
+
+test('accepts same start and end', () => assert.deepEqual(parseRange('5..5'), { start: 5, end: 5 }));
+
+test('rejects out-of-bounds start', () => assert.equal(parseRange('-100001..0'), null));
+test('rejects out-of-bounds end', () => assert.equal(parseRange('0..100001'), null));
+
+test('accepts boundary values', () => assert.deepEqual(parseRange('-100000..100000'), { start: -100000, end: 100000 }));
+
+test('rejects empty string', () => assert.equal(parseRange(''), null));
+
+test('rejects missing start', () => assert.equal(parseRange('..5'), null));
+test('rejects missing end', () => assert.equal(parseRange('5..'), null));
+
+test('rejects whitespace-only parts', () => assert.equal(parseRange('..'), null));
+
+test('accepts whitespace around separator', () => assert.deepEqual(parseRange('2 .. 7'), { start: 2, end: 7 }));
