+  // Boolean flag at config[feature] wins
+  if (typeof flag === 'boolean') return flag;
+
+  // Must be an object with enabled === true
+  if (flag === null || typeof flag !== 'object' || flag.enabled !== true) return false;
+
+  // No rollout means enabled
+  if (!('rollout' in flag)) return true;
+
+  const rollout = flag.rollout;
+
+  // rollout must be an integer from 0 through 100
+  if (!Number.isInteger(rollout) || rollout < 0 || rollout > 100) return false;
+
+  // 0 disables, 100 enables
+  if (rollout === 0) return false;
+  if (rollout === 100) return true;
+
+  // Percentage rollout: userId must be a non-empty string
+  const userId = context.userId;
+  if (typeof userId !== 'string' || userId === '') return false;
+
+  // Hash: unsigned 32-bit, iterate code points
+  let hash = 0;
+  for (const char of userId) {
+    const codePoint = char.codePointAt(0);
+    hash = (hash * 31 + codePoint) >>> 0;
+  }
+
+  const bucket = hash % 100;
+  return bucket < rollout;
 }
