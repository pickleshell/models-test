+
+  // context.feature must be a non-empty string
+  if (typeof context.feature !== 'string' || context.feature === '') return false;
+
+  const feature = context.feature;
+
+  // Exact boolean override wins
+  if (context.overrides !== null && typeof context.overrides === 'object') {
+    const override = context.overrides[feature];
+    if (typeof override === 'boolean') return override;
+  }
