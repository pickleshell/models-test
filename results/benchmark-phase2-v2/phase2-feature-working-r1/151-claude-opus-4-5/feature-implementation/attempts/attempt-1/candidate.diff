+  // Validate inputs: both must be non-null objects
+  if (config === null || typeof config !== 'object') return false;
+  if (context === null || typeof context !== 'object') return false;
+  
+  // context.feature must be a non-empty string
+  const feature = context.feature;
+  if (typeof feature !== 'string' || feature === '') return false;
+  
+  // Check exact boolean override first
+  if (context.overrides !== null && typeof context.overrides === 'object') {
+    const override = context.overrides[feature];
+    if (typeof override === 'boolean') {
+      return override;
+    }
+  }
+  
+  const flag = config[feature];
+  
+  // Boolean flag in config wins next
+  if (typeof flag === 'boolean') {
+    return flag;
+  }
+  
+  // Otherwise flag must be an object with enabled === true
+  if (flag === null || typeof flag !== 'object') return false;
+  if (flag.enabled !== true) return false;
+  
+  // Omitted rollout means enabled
+  if (!('rollout' in flag)) {
+    return true;
+  }
+  
+  const rollout = flag.rollout;
+  
+  // Rollout must be an integer from 0 through 100
+  if (typeof rollout !== 'number' || !Number.isInteger(rollout) || rollout < 0 || rollout > 100) {
+    return false;
+  }
+  
+  // 0 disables, 100 enables
+  if (rollout === 0) return false;
+  if (rollout === 100) return true;
+  
+  // For percentage rollout, context.userId must be a non-empty string
+  const userId = context.userId;
+  if (typeof userId !== 'string' || userId === '') return false;
+  
+  // Compute hash: for each Unicode code point, hash = (hash * 31 + codePoint) >>> 0
+  let hash = 0;
+  for (const char of userId) {
+    const codePoint = char.codePointAt(0);
+    hash = (hash * 31 + codePoint) >>> 0;
+  }
+  
+  // Bucket is hash % 100; enable exactly when bucket < rollout
+  const bucket = hash % 100;
+  return bucket < rollout;
 }
