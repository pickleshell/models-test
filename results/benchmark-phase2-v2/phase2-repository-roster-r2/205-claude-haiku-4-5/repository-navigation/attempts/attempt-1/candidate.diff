+  const trimmed = value.trim();
+  if (!trimmed) return '';
+  
+  // Replace separators with spaces and collapse multiple spaces
+  const normalized = trimmed.replace(/[_\-\s]+/g, ' ').trim();
+  
+  // Split into words and title-case each (except preserve numeric tokens)
+  const words = normalized.split(/\s+/).map(word => {
