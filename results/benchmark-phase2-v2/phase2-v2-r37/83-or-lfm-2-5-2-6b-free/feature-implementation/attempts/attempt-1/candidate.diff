+
+  // 1. Exact boolean value at context.overrides[context.feature] wins
+  if (context.overrides && context.overrides[context.feature] !== undefined) {
+    const overrideValue = context.overrides[context.feature];
+    if (typeof overrideValue === 'boolean') {
+      return overrideValue;
