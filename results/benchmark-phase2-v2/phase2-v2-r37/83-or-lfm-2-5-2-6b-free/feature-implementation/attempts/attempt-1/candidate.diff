+import { describe, it, expect } from 'node:test';
+import assert from 'node:assert/strict';
+import { resolveFeature } from '../src/featureFlags.js';
+
+describe('resolveFeature', () => {
+  it('supports booleans and exact boolean overrides', () => {
+    expect(resolveFeature({ chat: true, beta: false }, { feature: 'chat' })).toBe(true);
+    expect(resolveFeature({ chat: true }, { feature: 'chat', overrides: { chat: false } })).toBe(false);
+  });
+
+  it('handles zero and one hundred percent rollouts', () => {
+    expect(resolveFeature({ search: { enabled: true, rollout: 0 } }, { feature: 'search', userId: 'u1' })).toBe(false);
+    expect(resolveFeature({ search: { enabled: true, rollout: 100 } }, { feature: 'search', userId: 'u1' })).toBe(true);
+  });
+
+  it('uses the documented intermediate rollout vector', () => {
+    expect(resolveFeature({ search: { enabled: true, rollout: 50 } }, { feature: 'search', userId: 'a' })).toBe(false);
+  });
+});
