+
+test('parses an inclusive range', () => {
+  assert.deepEqual(parseRange('2..7'), { start: 2, end: 7 });
+});
+
+test('accepts surrounding whitespace', () => {
+  assert.deepEqual(parseRange(' -2..0 '), { start: -2, end: 0 });
+});
+
+test('rejects one malformed range (missing .. separator)', () => {
+  assert.equal(parseRange('2-7'), null);
+});
+
+test('rejects a reversed range', () => {
+  assert.equal(parseRange('7..2'), null);
+});
+
+test('rejects values outside the -100000 to 100000 range (lower bound)', () => {
+  assert.equal(parseRange('-100001..0'), null);
+});
+
+test('rejects values outside the -100000 to 100000 range (upper bound)', () => {
+  assert.equal(parseRange('100001..0'), null);
+});
+
+test('rejects decimal values (not integer)', () => {
+  assert.equal(parseRange('2.5..7'), null);
+});
+
+test('rejects hexadecimal notation', () => {
+  assert.equal(parseRange('0x2..7'), null);
+});
+
+test('rejects exponent notation', () => {
+  assert.equal(parseRange('2e3..7'), null);
+});
+
+test('rejects extra separators (more than one ..)', () => {
+  assert.equal(parseRange('2..7..9'), null);
+});
+
+test('rejects empty string', () => {
+  assert.equal(parseRange(''), null);
+});
+
+test('rejects non-string input (null)', () => {
+  assert.equal(parseRange(null), null);
+});
+
+test('rejects non-string input (number)', () => {
+  assert.equal(parseRange(123), null);
+});
+
+test('rejects negative zero (should be treated as 0)', () => {
+  // -0 is technically equal to 0, but let's verify it handles gracefully
+  assert.deepEqual(parseRange('-0..5'), { start: 0, end: 5 });
+});
+
+test('rejects positive zero', () => {
+  assert.deepEqual(parseRange('0..5'), { start: 0, end: 5 });
+});
+
+test('returns null for whitespace-only string', () => {
+  assert.equal(parseRange('   '), null);
+});
+
+test('handles leading zeros correctly', () => {
+  assert.deepEqual(parseRange('007..010'), { start: 7, end: 10 });
+});
+
+test('handles plus sign for positive numbers', () => {
+  assert.deepEqual(parseRange('+2..7'), { start: 2, end: 7 });
+});
+
+test('handles minus sign for negative numbers', () => {
+  assert.deepEqual(parseRange('-2..-7'), { start: -2, end: -7 });
+});
