 import test from 'node:test';
 import assert from 'node:assert/strict';
 import { parseRange } from '../src/range.js';
+
 test('parses an inclusive range', () => assert.deepEqual(parseRange('2..7'), { start: 2, end: 7 }));
 test('accepts surrounding whitespace', () => assert.deepEqual(parseRange(' -2..0 '), { start: -2, end: 0 }));
 test('rejects one malformed range', () => assert.equal(parseRange('2-7'), null));
 test('rejects a reversed range', () => assert.equal(parseRange('7..2'), null));
+
+// Additional meaningful tests
+test('handles positive numbers with plus sign', () => assert.deepEqual(parseRange('+5..+10'), { start: 5, end: 10 }));
+test('handles negative numbers', () => assert.deepEqual(parseRange('-50..-10'), { start: -50, end: -10 }));
+test('handles range at minimum boundary', () => assert.deepEqual(parseRange('-100000..100000'), { start: -100000, end: 100000 }));
+test('handles single point range at minimum', () => assert.deepEqual(parseRange('-100000..-100000'), { start: -100000, end: -100000 }));
+test('handles single point range at maximum', () => assert.deepEqual(parseRange('100000..100000'), { start: 100000, end: 100000 }));
+test('rejects decimal numbers', () => {
+  assert.equal(parseRange('1.5..3'), null);
+  assert.equal(parseRange('2..3.5'), null);
+  assert.equal(parseRange('1.5..3.5'), null);
+});
+test('rejects exponential notation', () => {
+  assert.equal(parseRange('1e2..3'), null);
+  assert.equal(parseRange('2..1e3'), null);
+  assert.equal(parseRange('1e2..1e3'), null);
+});
+test('rejects hexadecimal syntax', () => {
+  assert.equal(parseRange('0xa..0xb'), null);
+  assert.equal(parseRange('2..0xf'), null);
+  assert.equal(parseRange('0xa..0xf'), null);
+});
+test('rejects extra separators', () => {
+  assert.equal(parseRange('1..2..3'), null);
+  assert.equal(parseRange('1...2'), null);
+  assert.equal(parseRange('....'), null);
+});
+test('rejects empty sides', () => {
+  assert.equal(parseRange('..5'), null);
+  assert.equal(parseRange('5..'), null);
+  assert.equal(parseRange('..'), null);
+});
+test('rejects out of range values', () => {
+  assert.equal(parseRange('-100001..0'), null);
+  assert.equal(parseRange('0..100001'), null);
+  assert.equal(parseRange('-100001..100001'), null);
+});
+test('rejects non-string inputs', () => {
+  assert.equal(parseRange(null), null);
+  assert.equal(parseRange(undefined), null);
+  assert.equal(parseRange(123), null);
+  assert.equal(parseRange([]), null);
+  assert.equal(parseRange({}), null);
+});
+test('handles internal whitespace around numbers', () => {
+  assert.deepEqual(parseRange('  -5 ..  10  '), { start: -5, end: 10 });
+});
