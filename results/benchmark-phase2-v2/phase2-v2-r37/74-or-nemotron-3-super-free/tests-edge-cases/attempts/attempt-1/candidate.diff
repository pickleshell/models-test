 export function parseRange(value) {
   if (typeof value !== 'string') return null;
-  const [left, right] = value.split('..');
-  const start = Number(left);
-  const end = Number(right);
-  if (!Number.isInteger(start) || !Number.isInteger(end)) return null;
+  
+  // Trim whitespace from the entire string
+  const trimmed = value.trim();
+  
+  // Must contain exactly one '..'
+  const parts = trimmed.split('..');
+  if (parts.length !== 2) return null;
+  
+  // Trim each part and check for empty parts
+  const [left, right] = parts.map(part => part.trim());
+  if (left.length === 0 || right.length === 0) return null;
+  
+  // Validate integer format: optional + or - followed by digits only
+  const integerRegex = /^[+-]?\d+$/;
+  if (!integerRegex.test(left) || !integerRegex.test(right)) return null;
+  
+  // Parse as integers
+  const start = parseInt(left, 10);
+  const end = parseInt(right, 10);
+  
+  // Check range constraints
+  if (start < -100000 || start > 100000 || end < -100000 || end > 100000) return null;
+  
+  // Check that start <= end
+  if (start > end) return null;
+  
   return { start, end };
 }
diff --git a/fixtures/phase2-v2/tests-edge-cases/test/range.test.mjs b/fixtures/phase2-v2/tests-edge-cases/test/range.test.mjs
