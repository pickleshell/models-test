 import test from 'node:test';
 import assert from 'node:assert/strict';
 import { parseRange } from '../src/range.js';
+
 test('parses an inclusive range', () => assert.deepEqual(parseRange('2..7'), { start: 2, end: 7 }));
+
 test('accepts surrounding whitespace', () => assert.deepEqual(parseRange(' -2..0 '), { start: -2, end: 0 }));
+
 test('rejects one malformed range', () => assert.equal(parseRange('2-7'), null));
+
 test('rejects a reversed range', () => assert.equal(parseRange('7..2'), null));
+
+test('returns the start and end keys exactly', () => {
+  const r = parseRange('0..0');
+  assert.deepEqual(Object.keys(r).sort(), ['end', 'start']);
+  assert.equal(r.start, 0);
+  assert.equal(r.end, 0);
+});
+
+test('accepts a single-value range where start equals end', () => {
+  assert.deepEqual(parseRange('5..5'), { start: 5, end: 5 });
+});
+
+test('accepts explicit plus sign on both sides', () => {
+  assert.deepEqual(parseRange('+1..+10'), { start: 1, end: 10 });
+});
+
+test('accepts explicit minus sign on both sides', () => {
+  assert.deepEqual(parseRange('-10..-1'), { start: -10, end: -1 });
+});
+
+test('accepts mixed signs', () => {
+  assert.deepEqual(parseRange('-5..5'), { start: -5, end: 5 });
+});
+
+test('accepts inclusive boundary values', () => {
+  assert.deepEqual(parseRange('-100000..100000'), { start: -100000, end: 100000 });
+});
+
+test('accepts a single boundary value at minimum', () => {
+  assert.deepEqual(parseRange('-100000..-100000'), { start: -100000, end: -100000 });
+});
+
+test('accepts a single boundary value at maximum', () => {
+  assert.deepEqual(parseRange('100000..100000'), { start: 100000, end: 100000 });
+});
+
+test('rejects start below the minimum', () => {
+  assert.equal(parseRange('-100001..0'), null);
+});
+
+test('rejects end below the minimum', () => {
+  assert.equal(parseRange('0..-100001'), null);
+});
+
+test('rejects start above the maximum', () => {
+  assert.equal(parseRange('100001..100002'), null);
+});
+
+test('rejects end above the maximum', () => {
+  assert.equal(parseRange('0..100001'), null);
+});
+
+test('rejects an empty string', () => assert.equal(parseRange(''), null));
+
+test('rejects whitespace-only string', () => assert.equal(parseRange('   '), null));
+
+test('rejects missing end', () => assert.equal(parseRange('2..'), null));
+
+test('rejects missing start', () => assert.equal(parseRange('..7'), null));
+
+test('rejects missing separator entirely', () => assert.equal(parseRange('27'), null));
+
+test('rejects a single dot', () => assert.equal(parseRange('.'), null));
+
+test('rejects three dots', () => assert.equal(parseRange('2...7'), null));
+
+test('rejects multiple separators', () => assert.equal(parseRange('2..5..7'), null));
+
+test('rejects extra trailing characters after the range', () => {
+  assert.equal(parseRange('2..7x'), null);
+});
+
+test('rejects extra leading characters before the range', () => {
+  assert.equal(parseRange('x2..7'), null);
+});
+
+test('rejects internal whitespace around separator', () => {
+  assert.equal(parseRange('2 . . 7'), null);
+});
+
+test('accepts tabs and newlines as surrounding whitespace', () => {
