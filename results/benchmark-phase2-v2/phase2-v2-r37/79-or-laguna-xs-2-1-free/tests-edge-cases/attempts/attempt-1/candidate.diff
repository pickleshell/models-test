--- a/fixtures/phase2-v2/tests-edge-cases/src/range.js
+++ b/fixtures/phase2-v2/tests-edge-cases/src/range.js
@@ -1,8 +1,20 @@
+const INTEGER_REGEX = /^[+-]?\d+$/;
+const RANGE_REGEX = /^\s*[+-]?\d+\.\.\s*[+-]?\d+\s*$/;
+
 export function parseRange(value) {
   if (typeof value !== 'string') return null;
-  const [left, right] = value.split('..');
-  const start = Number(left);
-  const end = Number(right);
-  if (!Number.isInteger(start) || !Number.isInteger(end)) return null;
+  if (!RANGE_REGEX.test(value)) return null;
+  const trimmed = value.trim();
+  const dotIndex = trimmed.indexOf('..');
+  const left = trimmed.slice(0, dotIndex).trim();
+  const right = trimmed.slice(dotIndex + 2).trim();
+  if (!INTEGER_REGEX.test(left) || !INTEGER_REGEX.test(right)) return null;
+  let start = parseInt(left, 10);
+  let end = parseInt(right, 10);
+  if (Object.is(start, -0)) start = 0;
+  if (Object.is(end, -0)) end = 0;
+  if (start < -100000 || start > 100000) return null;
+  if (end < -100000 || end > 100000) return null;
+  if (start > end) return null;
   return { start, end };
 }
