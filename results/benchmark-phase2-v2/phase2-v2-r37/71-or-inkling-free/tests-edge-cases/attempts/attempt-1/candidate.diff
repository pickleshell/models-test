 import test from 'node:test';
 import assert from 'node:assert/strict';
 import { parseRange } from '../src/range.js';
+
 test('parses an inclusive range', () => assert.deepEqual(parseRange('2..7'), { start: 2, end: 7 }));
+
 test('accepts surrounding whitespace', () => assert.deepEqual(parseRange(' -2..0 '), { start: -2, end: 0 }));
+
 test('rejects one malformed range', () => assert.equal(parseRange('2-7'), null));
+
 test('rejects a reversed range', () => assert.equal(parseRange('7..2'), null));
+
+test('rejects non-string input', () => assert.equal(parseRange(42), null));
+
+test('rejects null input', () => assert.equal(parseRange(null), null));
+
+test('rejects undefined input', () => assert.equal(parseRange(undefined), null));
+
+test('rejects object input', () => assert.equal(parseRange({}), null));
+
+test('accepts negative numbers', () => assert.deepEqual(parseRange('-10..-3'), { start: -10, end: -3 }));
+
+test('accepts positive sign', () => assert.deepEqual(parseRange('+5..+10'), { start: 5, end: 10 }));
+
+test('accepts zero range', () => assert.deepEqual(parseRange('0..0'), { start: 0, end: 0 }));
+
+test('accepts boundary values', () => assert.deepEqual(parseRange('-100000..100000'), { start: -100000, end: 100000 }));
+
+test('rejects out of lower bound', () => assert.equal(parseRange('-100001..0'), null));
+
+test('rejects out of upper bound', () => assert.equal(parseRange('0..100001'), null));
+
+test('rejects decimals', () => assert.equal(parseRange('1.5..3'), null));
+
+test('rejects exponents', () => assert.equal(parseRange('1e3..5'), null));
+
+test('rejects hexadecimal', () => assert.equal(parseRange('0xA..0xB'), null));
+
+test('rejects extra separators', () => assert.equal(parseRange('1...3'), null));
+
+test('rejects missing end', () => assert.equal(parseRange('5..'), null));
+
+test('rejects missing start', () => assert.equal(parseRange('..5'), null));
+
+test('rejects extra text', () => assert.equal(parseRange('1..2..3'), null));
+
+test('rejects empty string', () => assert.equal(parseRange(''), null));
+
+test('rejects whitespace only', () => assert.equal(parseRange('   '), null));
+
+test('rejects start exceeds end by one', () => assert.equal(parseRange('5..4'), null));
+
+test('accepts equal start and end', () => assert.deepEqual(parseRange('8..8'), { start: 8, end: 8 }));
