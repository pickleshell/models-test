+  const trimmed = value.trim();
+  const parts = trimmed.split('..');
+  if (parts.length !== 2) return null;
+  const [left, right] = parts;
+  if (!/^[+-]?\d+$/.test(left) || !/^[+-]?\d+$/.test(right)) return null;
